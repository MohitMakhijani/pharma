model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Manufacturer {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Unit {
  id               String             @id @default(cuid())
  name             String             @unique
  symbol           String             @unique
  type             UnitType
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  baseProducts     Product[]          @relation("ProductBaseUnit")
  strengthProducts Product[]          @relation("StrengthUnit")
  packaging        ProductPackaging[]
}

enum UnitType {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  OTHER
}

model LedgerEntry {
  id              String          @id @default(cuid())
  storeId         String
  ledgerType      LedgerType
  customerId      String?
  supplierId      String?
  entryType       LedgerEntryType
  /// *
  /// * Positive amount:
  /// * money receivable from customer
  /// * OR money payable to supplier
  /// * Negative amount:
  /// * settlement/payment/adjustment
  amount          Decimal         @db.Decimal(14, 2)
  referenceId     String?
  referenceNumber String?
  description     String?
  entryDate       DateTime        @default(now())
  createdAt       DateTime        @default(now())
  customer        Customer?       @relation(fields: [customerId], references: [id])
  store           Store           @relation(fields: [storeId], references: [id])
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])

  @@index([storeId])
  @@index([customerId])
  @@index([supplierId])
  @@index([entryType])
  @@index([entryDate])
  @@index([referenceId])
}

model Payment {
  id              String        @id @default(cuid())
  storeId         String
  customerId      String?
  supplierId      String?
  amount          Decimal       @db.Decimal(14, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @default(now())
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  customer        Customer?     @relation(fields: [customerId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([storeId])
  @@index([customerId])
  @@index([supplierId])
  @@index([paymentDate])
}

enum LedgerType {
  CUSTOMER
  SUPPLIER
}

enum LedgerEntryType {
  OPENING_BALANCE
  SALE
  PURCHASE
  SALE_PAYMENT
  PURCHASE_PAYMENT
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  RECALLED
  BLOCKED
}

model Product {
  id String @id @default(cuid())

  storeId String

  name        String
  genericName String?
  brandName   String?

  sku     String
  barcode String?

  dosageForm String?

  strength       Decimal? @db.Decimal(12, 4)
  strengthUnitId String?

  categoryId     String?
  manufacturerId String?

  description String?

  gstPercent Decimal @default(0) @db.Decimal(5, 2)

  status ProductStatus @default(ACTIVE)

  /**
   * Inventory is always maintained in this unit.
   * Example:
   * Tablet = base unit
   */
  baseUnitId String

  minimumStock Decimal @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)

  store        Store         @relation(fields: [storeId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])

  strengthUnit Unit? @relation("StrengthUnit", fields: [strengthUnitId], references: [id])
  baseUnit     Unit  @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  packaging ProductPackaging[]
  batches   ProductBatch[]

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stocks              Stock[]
  prescriptionItems   PrescriptionItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([name])
  @@index([genericName])
  @@index([barcode])
}

model ProductPackaging {
  id String @id @default(cuid())

  productId String

  /**
   * Display name:
   * Tablet
   * Strip
   * Box
   * Bottle
   */
  name String

  unitId String

  /**
   * Number of base units contained
   * in ONE of this package.
   * Tablet = 1
   * Strip  = 10
   * Box    = 100
   */
  conversionToBase Decimal @db.Decimal(14, 3)

  /**
   * Can the cashier sell this package?
   */
  isSellable Boolean @default(true)

  /**
   * Can purchases arrive in this package?
   */
  isPurchaseUnit Boolean @default(true)

  /**
   * Optional barcode for this particular
   * packaging level.
   */
  barcode String?

  /**
   * Selling price for this packaging.
   * Useful when the pharmacy has different
   * pricing for loose tablets / strips / boxes.
   */
  sellingPrice Decimal? @db.Decimal(14, 2)

  /**
   * Maximum retail price for this packaging.
   */
  mrp Decimal? @db.Decimal(14, 2)

  isDefault Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unit Unit @relation(fields: [unitId], references: [id])

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  purchaseReturnItems PurchaseReturnItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([productId, name])
  @@index([productId])
  @@index([barcode])
}

model ProductBatch {
  id String @id @default(cuid())

  productId String
  storeId   String

  batchNumber String

  manufacturingDate DateTime?
  expiryDate        DateTime

  purchasePrice Decimal @db.Decimal(14, 2)
  mrp           Decimal @db.Decimal(14, 2)
  sellingPrice  Decimal @db.Decimal(14, 2)

  /**
   * ALWAYS stored in base units.
   * Example:
   * 1 box = 100 tablets
   * Purchase:
   * 5 boxes
   * quantity = 500
   */
  quantity Decimal @default(0) @db.Decimal(14, 3)

  reservedQuantity Decimal @default(0) @db.Decimal(14, 3)
  freeQuantity     Decimal @default(0) @db.Decimal(14, 3)

  status BatchStatus @default(ACTIVE)

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stocks              Stock[]
  purchaseReturnItems PurchaseReturnItem[]
  salesReturnItems    SalesReturnItem[]

  @@unique([storeId, productId, batchNumber])
  @@index([storeId])
  @@index([productId])
  @@index([expiryDate])
  @@index([status])
}
